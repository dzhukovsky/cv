{
  "routes": [
    {
      "route": "/match",
      "rewrite": "/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, noarchive, nofollow"
      }
    },
    {
      "route": "/*.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8"
      }
    }
  ],
  "mimeTypes": {
    ".md": "text/markdown"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.{png,jpg,jpeg,svg,ico,webp,gif,css,js,map,txt,md,pdf,docx,xml,json,woff,woff2,ttf,otf}"
    ]
  },
  "globalHeaders": {
    "X-Robots-Tag": "index, follow, noarchive"
  }
}
