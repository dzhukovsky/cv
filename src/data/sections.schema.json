{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cv.dzhukovsky.me/schemas/sections.schema.json",
  "title": "Sections",
  "description": "UI text for portfolio page sections — separate from cv.yml which holds CV data. Strings may contain `{projects.count}`, `{projects.areas}`, `{years}`, and `{recentYears}` tokens, replaced at render time via applyTemplate() in sections.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hero",
    "about",
    "experience",
    "technologies",
    "certifications",
    "education",
    "strengths",
    "cta"
  ],
  "properties": {
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availableTooltip", "stats"],
      "properties": {
        "availableTooltip": { "type": "string", "minLength": 1 },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["experience", "platforms", "technologies", "certifications"],
          "properties": {
            "experience": { "$ref": "#/$defs/StatLabel" },
            "platforms": { "$ref": "#/$defs/StatLabel" },
            "technologies": { "$ref": "#/$defs/StatLabel" },
            "certifications": { "$ref": "#/$defs/StatLabel" }
          }
        }
      }
    },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "expertise"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "expertise": {
          "type": "array",
          "description": "Four expertise-area highlights shown as cards in the About section.",
          "items": { "$ref": "#/$defs/ExpertiseCard" },
          "minItems": 1
        }
      }
    },
    "experience": {
      "$ref": "#/$defs/TitleDescription"
    },
    "technologies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "preferred"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "preferred": { "$ref": "#/$defs/TitleDescription" }
      }
    },
    "certifications": {
      "$ref": "#/$defs/TitleDescription"
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "strengths": {
      "$ref": "#/$defs/TitleDescription"
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "description"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "TitleDescription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "ExpertiseIcon": {
      "type": "string",
      "enum": ["cpu", "cloud", "database", "workflow"],
      "description": "Icon key — resolved to a lucide-react component in Portfolio.tsx."
    },
    "StatLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "suffix": { "type": "string", "minLength": 1 }
      }
    },
    "ExpertiseCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "icon"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/$defs/ExpertiseIcon" }
      }
    }
  }
}
