{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cv.dzhukovsky.me/schemas/cv.schema.json",
  "title": "CV",
  "description": "Schema for Dmitry Zhukovsky's CV data file (cv.yml).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fullName",
    "position",
    "location",
    "contractTypes",
    "email",
    "linkedIn",
    "github",
    "portfolio",
    "summary",
    "languages",
    "orgs",
    "techGroups",
    "technologies",
    "projects",
    "certifications",
    "education",
    "softSkills"
  ],
  "properties": {
    "fullName": { "type": "string", "minLength": 1 },
    "position": { "type": "string", "minLength": 1 },
    "location": { "$ref": "#/$defs/Location" },
    "contractTypes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "email": { "type": "string", "format": "email" },
    "linkedIn": { "type": "string", "minLength": 1 },
    "github": { "type": "string", "minLength": 1 },
    "portfolio": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Multi-paragraph intro text. Use a YAML literal block (`|`) — each line becomes a paragraph."
    },
    "languages": {
      "type": "array",
      "items": { "$ref": "#/$defs/Language" },
      "minItems": 1
    },
    "orgs": {
      "type": "array",
      "description": "Single source of truth for organizations (companies, universities, cert issuers). Each entry has one id-key whose value is the display name, plus a `logo` and optional `url`. Referenced by id from `projects[].company`, `education[].school`, `certifications[].issuer`.",
      "items": { "$ref": "#/$defs/OrgDef" },
      "minItems": 1
    },
    "techGroups": {
      "type": "object",
      "description": "Single source of truth for tech-group id → display name. Referenced by id-key in `technologies[]` and project `tech[]`.",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": { "type": "string", "minLength": 1 }
      }
    },
    "technologies": {
      "type": "array",
      "description": "Top-level self-taught technologies, grouped by tech group. Each entry has `group: <id>` and `items`.",
      "items": { "$ref": "#/$defs/SelfTaughtTechGroup" }
    },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/$defs/Project" },
      "minItems": 1
    },
    "certifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/Certification" }
    },
    "education": {
      "type": "array",
      "items": { "$ref": "#/$defs/Education" },
      "minItems": 1
    },
    "softSkills": {
      "type": "array",
      "items": { "$ref": "#/$defs/SoftSkill" }
    }
  },
  "$defs": {
    "YearMonth": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "description": "Year-month in YYYY-MM format (month-granular)."
    },
    "OrgId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Lowercase id referencing an organization defined in `orgs`. Schema only validates the format; existence of the reference must be checked at load time."
    },
    "LanguageLevel": {
      "type": "string",
      "enum": ["A1", "A2", "B1", "B2", "C1", "C2", "Native"]
    },
    "LogoSrc": {
      "description": "Either a single image path, or per-theme paths for light/dark.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "dark"],
          "properties": {
            "light": { "type": "string", "minLength": 1 },
            "dark": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "Location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "country", "countryCode"],
      "properties": {
        "city": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "minLength": 1 },
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 country code."
        }
      }
    },
    "Language": {
      "type": "object",
      "description": "One entry has the ISO 639-1 code as the property name (its value is the language name in English), plus a `level`.",
      "required": ["level"],
      "properties": {
        "level": { "$ref": "#/$defs/LanguageLevel" }
      },
      "patternProperties": {
        "^[a-z]{2}$": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "minProperties": 2,
      "maxProperties": 2
    },
    "OrgDef": {
      "type": "object",
      "description": "One organization entry — single id-key (e.g. `fotando`) whose value is the display name (e.g. `Fotando Global`), plus a `logo` and optional `url`.",
      "additionalProperties": false,
      "required": ["logo"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "logo": { "$ref": "#/$defs/LogoSrc" }
      },
      "patternProperties": {
        "^(?!url$|logo$)[a-z][a-z0-9-]*$": { "type": "string", "minLength": 1 }
      },
      "minProperties": 2,
      "maxProperties": 3
    },
    "ProjectTechItem": {
      "type": "object",
      "description": "A technology used inside a project. Group is implied by the parent entry. Missing start/end inherit from the project's start/end.",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/YearMonth" },
        "end": { "$ref": "#/$defs/YearMonth" }
      }
    },
    "SelfTaughtTechItem": {
      "type": "object",
      "description": "A self-taught technology inside a top-level tech-group entry. `start` is required; missing `end` means ongoing. Group is implied by the parent entry; source is implicitly `self-taught`.",
      "additionalProperties": false,
      "required": ["name", "start"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/YearMonth" },
        "end": { "$ref": "#/$defs/YearMonth" }
      }
    },
    "ProjectTechGroup": {
      "type": "object",
      "description": "Project techs grouped under one tech-group id (must match an entry in `techGroups`). Single id-key whose value is the list of techs.",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProjectTechItem" },
          "minItems": 1
        }
      }
    },
    "SelfTaughtTechGroup": {
      "type": "object",
      "description": "Self-taught techs grouped under one tech-group id (must match an entry in `techGroups`). Single id-key whose value is the list of techs.",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "type": "array",
          "items": { "$ref": "#/$defs/SelfTaughtTechItem" },
          "minItems": 1
        }
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "company",
        "position",
        "start",
        "areas",
        "description",
        "contributions",
        "tech"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "company": { "$ref": "#/$defs/OrgId" },
        "position": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/YearMonth" },
        "end": { "$ref": "#/$defs/YearMonth" },
        "areas": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "description": { "type": "string", "minLength": 1 },
        "contributions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "tech": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProjectTechGroup" },
          "minItems": 1
        }
      }
    },
    "Certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "code",
        "issuer",
        "about",
        "issued",
        "credentialId",
        "credentialUrl"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "issuer": { "$ref": "#/$defs/OrgId" },
        "about": { "type": "string", "minLength": 1 },
        "issued": { "$ref": "#/$defs/YearMonth" },
        "expires": { "$ref": "#/$defs/YearMonth" },
        "credentialId": { "type": "string", "minLength": 1 },
        "credentialUrl": { "type": "string", "format": "uri" }
      }
    },
    "Education": {
      "type": "object",
      "additionalProperties": false,
      "required": ["school", "degree", "field", "start"],
      "properties": {
        "school": { "$ref": "#/$defs/OrgId" },
        "degree": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/YearMonth" },
        "end": { "$ref": "#/$defs/YearMonth" }
      }
    },
    "SoftSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
